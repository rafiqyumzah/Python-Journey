# It is possible to nest lists(create lists containing other lists)

numbers = [1,2,3,4,5]
letters = ["a" , "b" , "c" , "d" , "e" ]
mix = [numbers,letters]
print(mix)
print("\n")
print(mix[0][2])
print('\n')
print(mix[1][2])
print('\n')
print(mix[0][0])
print(mix[0][1])
print(mix[0][2])
print(mix[0][3])
print(mix[0][4])

print('\n')

print(mix[1][0:5])
