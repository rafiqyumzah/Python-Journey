f = r'A raw string such as this \n Must not end \n In an odd number of "\n" backslashes ' # This is a raw string literal
g = r' Instead, it must end \n with an even number of "\ backslashes" like this '


print ("")
print (d)
print (e)
print ("\n")
print (f)
print (g)

