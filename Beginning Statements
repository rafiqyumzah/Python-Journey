# Using the if Statement
x = int(input("How old are you?"))
if x < 0:
        x = 0
        print("A negative number was converted to Zero")
elif x == 0:
    print("Zero")
elif x == 1:
    print("Single")
elif x == 2:
    print("Double")
elif x == 3:
    print(" Triple ")
else:
    print("More than coded for")
    
